# Every environment variable the Shop Book server reads, with what it holds.
# Copy this file to `.env` (development) and `.env.test` (tests, with a
# DIFFERENT database: the tests create and delete their own data) and fill in
# your own values. Never commit those files. On Render, type each variable in
# the dashboard by hand; never paste a local .env there.
# The server checks all of them at start-up and stops with a clear message if
# one is missing or wrong.

# development | test | production
NODE_ENV=development

# Port the server listens on (Render sets PORT itself in production).
PORT=3000

# --- MySQL --------------------------------------------------------------
# Host and port of the MySQL server (local: localhost and 3306).
DB_HOST=localhost
DB_PORT=3306
# Database name: e.g. shopbook_dev in .env, shopbook_test in .env.test.
DB_NAME=shopbook_dev
# MySQL user and password with full rights on that database.
DB_USER=shopbook
DB_PASSWORD=
# The database's CA certificate (Aiven's ca.pem), needed in production, given
# ONE of two ways (setting both is refused). Leave both empty locally.
# 1. A path to the file. On your laptop keep it OUTSIDE this project folder
#    (for example ~/certs/shopbook-aiven-ca.pem); on Render, a Secret File
#    (shown at /etc/secrets/<name>).
DB_SSL_CA_PATH=
# 2. Or the certificate's text itself, from -----BEGIN CERTIFICATE----- to
#    -----END CERTIFICATE-----, on several lines or on one line with \n
#    between them. Use this if Secret Files aren't available.
DB_SSL_CA=

# --- The phone app -------------------------------------------------------
# The app's address (scheme, host and port, no path). Used by CORS and the
# Origin check. Locally this is the Vite dev address; in production the
# Vercel address.
CLIENT_URL=http://localhost:5173
# The app's address used in email links (confirm email, reset password).
# Normally the same value as CLIENT_URL; if left empty outside production,
# CLIENT_URL is used. Required in production.
APP_URL=

# --- Sessions --------------------------------------------------------------
# Secret that signs the sign-in cookie. A long random value, different in
# each environment; at least 32 characters in production. Make one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs everybody out.
JWT_SECRET=

# --- Email (Brevo HTTPS API) ------------------------------------------------
# Only used in production (development prints emails in the terminal, tests
# keep them in memory). All three are required in production.
# Brevo API key (Brevo → SMTP & API → API keys).
EMAIL_API_KEY=
# The verified sender address, and the name shown as the sender.
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Shop Book

# --- Proxies and logging --------------------------------------------------
# Number of proxies in front of the server (Vercel's rewrite, Render's router),
# so req.ip is the phone's address. 0 locally. Required in production; the
# right number is found in BE1 Part B and written in the README.
TRUST_PROXY=0
# debug | info | warn | error | silent (default: info; silent in tests).
LOG_LEVEL=info
# true only while checking the proxy chain in BE1 Part B: logs req.ip and
# X-Forwarded-For for each request. Turn it off again afterwards.
LOG_PROXY_CHAIN=false
