                  "pm.test('Ghana, GHS', () => { pm.expect(pm.response.json().countries[0].code).to.eql('GH'); pm.expect(pm.response.json().currencies[0].minorUnits).to.eql(2); });"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH /api/business/locale (owner; X-Business)",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/business/locale",
            "header": [
              {
                "key": "X-Requested-With",
                "value": "XMLHttpRequest"
              },
              {
                "key": "X-Business",
                "value": "{{businessId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"country\": \"GH\",\n  \"currency\": \"GHS\",\n  \"timezone\": \"Africa/Accra\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200 (or 409 CURRENCY_LOCKED once money exists)', () => pm.expect([200, 409]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
